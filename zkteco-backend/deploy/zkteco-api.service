[Unit]
Description=ZKTeco C3 Access Control API
Documentation=file:/opt/zkteco-backend/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=zkteco
Group=zkteco
WorkingDirectory=/opt/zkteco-backend
EnvironmentFile=/opt/zkteco-backend/.env
Environment=SCHEDULER_ENABLED=false

# The scheduler runs in the separate worker unit; keep it off here so that
# multiple uvicorn workers cannot each start their own copy of the jobs.
ExecStart=/opt/zkteco-backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/zkteco-backend

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zkteco-api

[Install]
WantedBy=multi-user.target
