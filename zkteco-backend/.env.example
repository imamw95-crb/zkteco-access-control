# Copy to .env and adjust. The app reads these via pydantic-settings.

# --- database ----------------------------------------------------------------
# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql+psycopg://zkteco:zkteco@localhost:5432/zkteco
# Local dev without Postgres:
# DATABASE_URL=sqlite:///./zkteco.db

# --- device communication ----------------------------------------------------
DEVICE_PORT=4370
DEVICE_CONNECT_TIMEOUT=4
DEVICE_RECEIVE_TIMEOUT=4
DEVICE_RECEIVE_RETRIES=2
DEVICE_MAX_RETRIES=3
DEVICE_RETRY_BACKOFF=0.5
DEVICE_PARALLELISM=8

# --- scheduler ---------------------------------------------------------------
# Set to true in the worker process only.
SCHEDULER_ENABLED=false
LOG_POLL_INTERVAL_SECONDS=60
HEALTH_CHECK_INTERVAL_SECONDS=120

# --- Windows push agent (writing to panels) ----------------------------------
# Writing needs the official Pull SDK DLL, which is 32-bit and cannot be loaded
# by this 64-bit backend. A separate Windows agent does the writing; see
# agent/README.md. Leave PUSH_AGENT_URL empty to keep writing disabled — the
# sync endpoint then answers 503 with an explanation instead of doing nothing.
PUSH_AGENT_URL=
PUSH_AGENT_TOKEN=

# --- network scan (dashboard tab "Cari Device") -------------------------------
# Subnets a range scan may touch, comma separated. A wide sweep is visible on the
# network, so the limit is explicit and lives here rather than in the code.
SCAN_ALLOWED_NETWORKS=10.100.1.0/24,192.168.1.0/24
# Hard cap on addresses per scan, so a typo like 10.0.0.0/8 cannot fire 16M probes.
SCAN_MAX_HOSTS=4096
# Parallel TCP probes. Identification of a found panel is always sequential — a C3
# panel accepts only one connection at a time.
SCAN_WORKERS=64

# --- writing a panel's own network configuration (ZKAccess "Modify IP Address") ---
# OFF by default, and that default is the safety mechanism. This is the only
# operation here that can leave a panel unreachable WITH NO WAY BACK: a wrong address
# has to be corrected at the device itself, in the ceiling of a ward if that is where
# it hangs. Turn it on only to move a panel you cannot reach by hand, and test on ONE
# panel first. Even then the write needs a dry run of the exact same values.
PANEL_NETWORK_WRITE_ENABLED=false
PUSH_AGENT_TIMEOUT=60

LOG_LEVEL=INFO
